# ---------------------------------------------------------------------------
# Copiá este archivo a .env.local y completá los valores.
# .env.local NO va al repositorio.
# ---------------------------------------------------------------------------

# --- Base de datos ---------------------------------------------------------
#
# En PRODUCCIÓN: la cadena del POOLER de Supabase, puerto 6543.
#   Supabase -> Project Settings -> Database -> Connection string
#              -> Transaction pooler
#
# Tiene que ser el pooler (6543) y no la conexión directa (5432): en serverless
# cada invocación abre su propia conexión y el límite de directas se agota.
#
#   DATABASE_URL=postgresql://postgres.PROYECTO:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
#
# En DESARROLLO se puede usar PGlite: Postgres compilado a WASM que corre en
# proceso, sin Docker ni base remota. Es Postgres real, así que valida el SQL y
# las funciones de fecha igual que el servidor.
#
# Ojo: PGlite soporta UN solo proceso a la vez. Si querés correr el dev server y
# los scripts al mismo tiempo, necesitás un Postgres de verdad.
DATABASE_URL=pglite://./data/pg

# Conexiones por instancia. Pocas a propósito: en serverless son muchas
# instancias chicas, no una grande.
DB_MAX_CONEXIONES=3

# --- Zona horaria de la planta ---------------------------------------------
#
# Nombre de zona, NO un offset fijo: así el agrupado "por día" sigue bien si
# alguna vez vuelve el horario de verano.
#
# Es lo que hace que el turno noche no se parta en dos días: una caja de las
# 21:30 de Buenos Aires es 00:30 UTC del día siguiente.
TZ_PLANTA=America/Argentina/Buenos_Aires

# --- Sesión ----------------------------------------------------------------
#
# Secreto para firmar la cookie de sesión. Mínimo 32 caracteres.
# Generalo con:  openssl rand -hex 32
# Si no se define, la app genera uno y lo guarda en la base.
SESSION_SECRET=

# --- Impresora (paso 3, cuando esté comprada) ------------------------------
#
# La impresora vive en la LAN de la fábrica, así que el servidor en la nube no
# la alcanza: le habla un agente local. Ver agente-impresion/README.md
PRINTER_HOST=
PRINTER_PORT=9100

# --- Solo para demos ------------------------------------------------------
#
# Si la base está vacía al arrancar, se siembra con catálogos de ejemplo.
# En producción dejar apagado.
SEMBRAR_SI_VACIO=0

# PINs del primer arranque. Si no se definen usa los del repo, que no sirven
# para una URL pública porque están escritos en la documentación.
PIN_JEFE_INICIAL=
PIN_CALIDAD_INICIAL=
PIN_ADMIN_INICIAL=

# Banner de "ambiente de prueba" arriba de la pantalla.
MODO_DEMO=0
