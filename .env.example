# Ruta del archivo SQLite (relativa a la raiz del proyecto)
DB_PATH=data/etiquetado.db

# Impresora de etiquetas: IP en la LAN y puerto raw (9100 es el estandar)
# Se completa cuando llegue la impresora. Sin esto, la app guarda pero no imprime.
PRINTER_HOST=
PRINTER_PORT=9100

# Zona horaria de la planta (Argentina = -3). Se usa para agrupar produccion
# "por dia": sin esto, el turno noche se partiria en dos dias distintos.
TZ_OFFSET_HORAS=-3

# --- Solo para demos con disco efimero -------------------------------------
# Si la base esta vacia al arrancar, se siembra sola con catalogos de ejemplo.
# En produccion dejar apagado (o sin definir).
SEMBRAR_SI_VACIO=0
# PINs del primer arranque. Si no se definen, usa los del repo (no sirven para
# una URL publica).
PIN_JEFE_INICIAL=
PIN_CALIDAD_INICIAL=
PIN_ADMIN_INICIAL=

# Banner de "ambiente de prueba"
MODO_DEMO=0
